# Copy to .env.local for local overrides; set these on the host (Render / Railway) in production.

# --- required in production ---
# Signs admin sign-in cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Operator password for /admin (all yards + demo requests). Use a long, unique password.
ADMIN_PASSWORD=

# --- recommended ---
# Canonical site URL (used for share images, sitemap, robots).
SITE_URL=https://pardical.com
# Pardical's own hostnames; any other hostname is looked up as a yard's custom domain.
APP_HOSTS=pardical.com,www.pardical.com
# SQLite file. The Docker image defaults to /data/app.db — mount a persistent disk at /data.
# DATABASE_PATH=/data/app.db
# Discord or Slack incoming-webhook URL: get a message for every demo request and yard lead.
LEAD_WEBHOOK_URL=

# --- optional ---
# Claude-written chat replies on yard websites (otherwise rules-based answers from inventory).
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5-5
# Existing Pardical pricing tool for live market checks (off by default). Both values are needed.
# PRICING_API_URL=
# PRICING_API_PHONE=

# --- company profile for KYC reviewers (/legal/company-profile; 404 until all four are set) ---
# Kept out of the repo on purpose. Separate address lines with |
KYC_OWNER_NAME=
KYC_EMAIL=
KYC_PHONE=
KYC_ADDRESS=
