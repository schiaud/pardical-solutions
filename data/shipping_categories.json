{
  "_comment": "Shipping categories for the quote estimator. Each rule is tried in order against a listing title or a car-part.com part name (case-insensitive); the first match wins, so order encodes specificity. The pattern syntax is the common subset of JavaScript and Python regular expressions so scripts/extract_shipping_history.mjs (reads real order history) and src/utils/shipping_estimator.py (runtime) share one source of truth. size_class picks the fallback estimate when a category has too little history: small (under ~3 lb), medium (~3-15 lb), large (~15-40 lb), oversize (dimensional parcels), freight (LTL / pallet). History is never used for oversize or freight classes: Pardical's parcel history cannot contain those shipments, so anything landing there is a misclassified small part.",
  "size_classes": ["small", "medium", "large", "oversize", "freight"],
  "rules": [
    {"category": "Wiper Motor", "size_class": "medium", "pattern": "wiper motor"},
    {"category": "Cooling Fan", "size_class": "medium", "pattern": "cooling fan|radiator fan|fan assembly|fan clutch|fan motor|fan shroud"},
    {"category": "Coolant Reservoir/Overflow Tank", "size_class": "medium", "pattern": "coolant reservoir|overflow tank|expansion tank|overflow bottle|coolant bottle|degas bottle"},
    {"category": "Vapor Canister", "size_class": "medium", "pattern": "vapor canister|charcoal canister|evaporator canister|emission canister|evap canister|fuel vapor"},
    {"category": "Air Cleaner Box/Intake Housing", "size_class": "large", "pattern": "air cleaner box|air intake box|air filter housing|air cleaner intake|air cleaner|air box|intake cleaner|intake filter|air intake housing|air intake"},
    {"category": "Engine", "size_class": "freight", "pattern": "^engine$|^engine \\(|\\bengine assembly\\b|\\bcomplete engine\\b|\\blong block\\b|\\bshort block\\b|\\bmotor assembly\\b"},
    {"category": "Transmission", "size_class": "freight", "pattern": "^transmission|^automatic transmission|^manual transmission|\\btransmission assembly\\b|\\btransaxle\\b|\\bgearbox\\b"},
    {"category": "Transfer Case", "size_class": "freight", "pattern": "transfer case"},
    {"category": "Differential/Axle Assembly", "size_class": "freight", "pattern": "\\bdifferential\\b|\\brear axle assembly\\b|\\bcarrier assembly\\b|\\brear end\\b|^axle assembly"},
    {"category": "Subframe/Crossmember", "size_class": "freight", "pattern": "subframe|crossmember|\\bcradle\\b"},
    {"category": "Bumper", "size_class": "oversize", "pattern": "^bumper|\\bbumper assembly\\b|\\bbumper assy\\b|\\bbumper cover\\b|\\bfront bumper\\b|\\brear bumper\\b"},
    {"category": "Hood/Fender/Door/Tailgate", "size_class": "oversize", "pattern": "^hood$|^hood \\(|\\bhood panel\\b|^fender|\\bfender panel\\b|^door \\(|^front door$|^rear door$|\\bdoor shell\\b|^tailgate|^liftgate|^decklid|\\btrunk lid\\b|^quarter panel|\\bpickup bed\\b|^roof"},
    {"category": "Windshield/Glass", "size_class": "oversize", "pattern": "^windshield|windshield glass|back glass|rear glass|quarter glass|door glass|window glass"},
    {"category": "Seat", "size_class": "oversize", "pattern": "^seat|\\bfront seat\\b|\\brear seat\\b|\\bseat assembly\\b|\\bseat, front\\b|\\bseat, rear\\b"},
    {"category": "Wheel/Rim", "size_class": "large", "pattern": "\\bwheel\\b.*\\b(rim|alloy|aluminum|steel)\\b|\\brim\\b|\\bwheel \\(display\\b|^wheel$"},
    {"category": "Spindle/Knuckle", "size_class": "large", "pattern": "\\bspindle\\b|\\bknuckle\\b"},
    {"category": "Radiator", "size_class": "large", "pattern": "\\bradiator\\b(?!.*(support|fan|shroud|hose|cap|overflow|tank|reservoir|bracket|cover|guide|baffle|core support|tie bar))"},
    {"category": "Condenser", "size_class": "large", "pattern": "\\bcondenser\\b"},
    {"category": "Intercooler", "size_class": "large", "pattern": "intercooler"},
    {"category": "Intake Manifold", "size_class": "large", "pattern": "intake manifold|vortec intake"},
    {"category": "Exhaust Manifold", "size_class": "large", "pattern": "exhaust manifold|\\bheader\\b"},
    {"category": "Cylinder Head", "size_class": "large", "pattern": "cylinder head"},
    {"category": "Steering Rack/Gear", "size_class": "large", "pattern": "steering (rack|gear)|rack (and|&) pinion"},
    {"category": "Axle Shaft/CV", "size_class": "large", "pattern": "axle shaft|\\bcv axle\\b|half ?shaft|drive shaft|driveshaft"},
    {"category": "Suspension (Arms/Sway/Kit)", "size_class": "large", "pattern": "suspension kit|control arm|sway bar|trailing arm|tie rod|\\bstrut\\b(?!.*(mount|bearing|boot))|\\bshock\\b"},
    {"category": "Column Switch/Steering Column", "size_class": "large", "pattern": "\\bcolumn\\b.*\\bswitch\\b|steering column"},
    {"category": "Console/Front", "size_class": "large", "pattern": "\\bconsole\\b"},
    {"category": "Grille", "size_class": "large", "pattern": "\\bgrille?\\b"},
    {"category": "Headlight Assembly", "size_class": "medium", "pattern": "headlight|headlamp|head light|head lamp"},
    {"category": "Tail Light", "size_class": "medium", "pattern": "tail light|tail lamp|taillight|taillamp|3rd brake light|third brake light"},
    {"category": "Fog/Corner/Marker Light", "size_class": "small", "pattern": "fog (light|lamp)|corner (light|lamp)|marker (light|lamp)|park(ing)? (light|lamp)|turn signal"},
    {"category": "AC/Heater Control", "size_class": "small", "pattern": "a\\/?c[\\s/]*heater|heater[\\s/]*a\\/?c|heater.*(a\\/?c|climate|temperature)|climate.*(control|temp)|hvac.*(switch|control)|temperature control|temperature a\\/?c control"},
    {"category": "ABS Pump/Module", "size_class": "medium", "pattern": "\\babs\\b.*(pump|module|unit|brake)|anti-?lock brake.*(pump|module|assembly|unit|computer|parts?)|anti lock brake.*(pump|module|assembly)|antilock brake"},
    {"category": "AC Compressor", "size_class": "medium", "pattern": "a\\/?c\\s*(air\\s*)?compressor|air condition(er|ing).*compressor"},
    {"category": "Power Brake Booster/Master Cylinder", "size_class": "medium", "pattern": "brake booster|master cylinder"},
    {"category": "Alternator", "size_class": "medium", "pattern": "alternator"},
    {"category": "Starter", "size_class": "medium", "pattern": "\\bstarter\\b"},
    {"category": "Fuel Pump", "size_class": "medium", "pattern": "fuel (supply )?pump|fuel tank pump"},
    {"category": "Power Steering Pump", "size_class": "medium", "pattern": "power steering pump"},
    {"category": "Timing Cover", "size_class": "medium", "pattern": "timing (chain )?cover"},
    {"category": "Valve Cover", "size_class": "medium", "pattern": "valve cover"},
    {"category": "Washer Reservoir/Fluid", "size_class": "medium", "pattern": "washer (fluid )?reservoir|washer bottle"},
    {"category": "Speedometer/Instrument Cluster", "size_class": "medium", "pattern": "speedomet|instrument cluster|gauge cluster|instr\\. cluster"},
    {"category": "Radio/Infotainment", "size_class": "medium", "pattern": "\\bradio\\b|am fm|cd\\/?mp3|tv screen|navigation|display screen|infotainment"},
    {"category": "Door Mirror", "size_class": "medium", "pattern": "door mirror|side view mirror|view door mirror|mirror, door|side mirror|\\bmirror\\b"},
    {"category": "Power Window Switch/Regulator", "size_class": "medium", "pattern": "window switch|window regulator|door switch|window motor"},
    {"category": "Door Lock Latch/Actuator", "size_class": "small", "pattern": "door lock latch|lock actuator|door latch|hood latch|tailgate latch"},
    {"category": "Caliper", "size_class": "medium", "pattern": "\\bcaliper\\b"},
    {"category": "Gear Shifter/Shift Assembly", "size_class": "medium", "pattern": "gear shift|shifter assembly|floor shift|\\bshifter\\b"},
    {"category": "Throttle Body", "size_class": "medium", "pattern": "throttle body|throttle valve"},
    {"category": "Turbocharger/Supercharger", "size_class": "medium", "pattern": "turbocharger|supercharger|\\bturbo\\b"},
    {"category": "Carburetor", "size_class": "medium", "pattern": "carburetor"},
    {"category": "Blower Motor", "size_class": "medium", "pattern": "blower motor"},
    {"category": "Brake Rotor/Drum/Hub", "size_class": "medium", "pattern": "\\brotor\\b|\\bbrake drum\\b|\\bhub\\b"},
    {"category": "Distributor/Ignition Parts", "size_class": "small", "pattern": "\\bdistributor\\b|ignition coil|spark plug|ignition module"},
    {"category": "Sun Visor", "size_class": "small", "pattern": "sun ?visor"},
    {"category": "Ignition Switch", "size_class": "small", "pattern": "ignition switch|keyless ignition|ignition lock"},
    {"category": "Mass Air Flow Sensor", "size_class": "small", "pattern": "mass air flow|\\bmaf\\b sensor"},
    {"category": "Fuel Injector/Rail", "size_class": "small", "pattern": "fuel injector|injector.*rail"},
    {"category": "Sensors/Switches/Modules", "size_class": "small", "pattern": "\\bsensor\\b|\\bswitch\\b|\\bmodule\\b|\\brelay\\b|\\bcomputer\\b|\\becm\\b|\\becu\\b|\\bpcm\\b|\\bbcm\\b|\\btcm\\b|key remote|\\bfob\\b|\\bkey\\b|\\bcamera\\b|\\bantenna\\b|\\bactuator\\b|\\bsolenoid\\b|\\binverter\\b|\\bconverter\\b"},
    {"category": "Body/Exterior Trim", "size_class": "medium", "pattern": "rocker panel|roll pan|fender flare|wheel molding|bumper cap|weatherstrip|\\bemblem\\b|\\bmolding\\b|\\btrim\\b|\\bbezel\\b|\\blens\\b"},
    {"category": "Detailing/Car-Care Products (non-part)", "size_class": "small", "pattern": "armor all|meguiar|adam'?s (polish|arsenal)|adam’s|malco |invisible glass|stoner car|ethos (defy|finish|wheel|touchless)|\\b3d (glw|bdx|x-treme|sweet)|carfidant|cerakote|resist graphene|dupli-?color|ezpz |boat juice|p ?& ?s professional|swift touchless|wax\\b|shampoo|detailer|ceramic coating|wheel cleaner|tire shine|glass cleaner|car wash|polishing compound|scratchx|bug (remover|& tar)"}
  ]
}
